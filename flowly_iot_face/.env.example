FACE_SERVICE_SECRET=troque-por-um-segredo-interno-longo-e-aleatorio
FACE_MAX_IMAGE_BYTES=10485760
FACE_MAX_REQUEST_BYTES=15728640
FACE_CORS_ORIGIN=
FACE_MODEL=VGG-Face
FACE_DETECTOR=opencv
FACE_MATCH_THRESHOLD=0.4
FACE_VERIFY_THRESHOLD=0.5

# Pesos do modelo. Na imagem Docker: DEEPFACE_HOME=/opt/deepface, pesos baixados e conferidos no build,
# FACE_REQUIRE_LOCAL_WEIGHTS=1 (sem os pesos, 503 em vez de baixar) e FACE_PRELOAD_MODEL=1.
# Localmente, rode `python fetch_face_weights.py` uma vez ou deixe o DeepFace baixar no primeiro uso.
# DEEPFACE_HOME=
DEEPFACE_BACKEND_ENGINE=tensorflow
FACE_REQUIRE_LOCAL_WEIGHTS=0
FACE_PRELOAD_MODEL=0
