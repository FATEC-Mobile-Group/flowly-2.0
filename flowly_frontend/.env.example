# Flowly Frontend - build-time environment template
# Vite embeds VITE_* values during build. Configure these in CI/CD before build.

# Production / cloud
VITE_API_URL=https://SEU_BACKEND_URL/api
VITE_API_PUBLIC_URL=https://SEU_BACKEND_URL
VITE_SOCKET_URL=https://SEU_BACKEND_URL
VITE_ASSISTANT_URL=https://SEU_ASSISTENTE_URL

# Local development example
# VITE_API_URL=http://localhost:5000/api
# VITE_API_PUBLIC_URL=http://localhost:5000
# VITE_SOCKET_URL=http://localhost:5000
# VITE_ASSISTANT_URL=http://localhost:8080
